{
  "name": "quiz-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "dev:frontend": "pnpm --filter @quiz-app/frontend dev",
    "dev:backend": "pnpm --filter @quiz-app/backend dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "mongodb": "^7.2.0"
  }
}
